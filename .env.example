# ============================================================
# porto-web — Environment Variable Reference
# ============================================================
# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is already listed in .gitignore.
# ============================================================

# ---- Runtime environment ------------------------------------
# Set to "production" in production deployments. Next.js uses
# this to enable the Secure cookie flag and other prod-only guards.
NODE_ENV=development

# ---- Database (optional) ------------------------------------
# Prisma defaults to file:./dev.db (relative to prisma/).
# Uncomment to use a different file, e.g. for production.
# DATABASE_URL="file:./prod.db"

# ---- Admin account seed (development) -----------------------
# Used ONLY by `npm run db:seed` to create the initial admin
# record in development. NOT read at runtime — the hashed
# credential is stored in the database.
# ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_PASSWORD=YourStrongPassword1!

# ---- Production admin creation ------------------------------
# Used by `npm run db:create-admin` to create the first admin
# account on the server. Never commit real values.
# ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_PASSWORD=YourStrongPassword1!

# ---- Admin host (production) -------------------------------
# Designated admin subdomain, e.g. admin.example.com.
# Server-side only. Do NOT use a NEXT_PUBLIC_ prefix.
# ADMIN_HOST=admin.example.com
